{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=FbrPos;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "replace-with-a-long-random-secret",
    "Issuer": "FbrPosSystem",
    "Audience": "FbrPosUsers",
    "ExpiryInHours": 8
  },
  "FbrApi": {
    "BaseUrl": "https://api.fbr.gov.pk",
    "TimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
